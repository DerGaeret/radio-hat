# Radio HAT: Verstaerker beim Booten einschalten und vor dem Herunterfahren sauber abschalten
# (Datenblatt TAS5805M Kap. 7.5.3.1 und 7.5.3.2). Einrichtung siehe README.md, Abschnitt "Pi einrichten".
[Unit]
Description=Radio HAT Verstaerker TAS5805M
After=sound.target dev-i2c\x2d1.device
Wants=dev-i2c\x2d1.device
# Wiedergabeprogramme erst danach starten und beim Herunterfahren vorher beenden
Before=mpd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/radio_hat_start.sh start
ExecStop=/usr/local/bin/radio_hat_start.sh stop

[Install]
WantedBy=multi-user.target
